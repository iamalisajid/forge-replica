{
  "name": "forge-replica",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "npm run build:web && npm run build:api",
    "build:web": "vite build --config web/vite.config.ts",
    "build:api": "tsc -p api",
    "typecheck": "tsc -p api --noEmit && tsc -p web --noEmit",
    "start": "node api/dist/server.js",
    "db:generate": "prisma generate --schema db/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema db/schema.prisma",
    "contract:types": "openapi-typescript contract/openapi.yaml -o web/src/api/types.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "10.1.6",
    "@node-rs/argon2": "2.2.2",
    "@prisma/client": "6.19.3",
    "fastify": "5.12.7",
    "openapi-fetch": "0.17.0",
    "prisma": "6.19.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
